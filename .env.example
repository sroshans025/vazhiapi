# VazhiAPI — Environment Variables
# Copy this file to frontend/.env.local and fill in real values for local development.
# On Vercel, add these under Project → Settings → Environment Variables.

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
# URL of the deployed FastAPI backend (no trailing slash)
# Local development default: http://localhost:8000
# Production example:        https://your-backend.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000
