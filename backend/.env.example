# Copy to backend/.env
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# DATABASE_URL=postgresql://user:pass@host:5432/vazhiapi   (default: local SQLite)
# Optional — enables Claude-powered chat (otherwise the built-in counsellor is used)
# ANTHROPIC_API_KEY=sk-ant-...
# CHAT_LLM=auto            # auto | anthropic | local
# Optional — create an admin account on startup
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me
